# Spring Systems API
SPRING_API_BASE_URL=https://staging-portalapp.springsystems.com/api/
SPRING_API_USER=
SPRING_API_KEY=
SPRING_RETAILER_ID=
# Only needed for --create-invoice -- our own vendor tp_id in Spring (not the retailer's)
SPRING_VENDOR_ID=
# Gates the Spring leg of /po-invoice (1/true/yes/on to enable). Leave OFF until
# Spring grants this API user permission for invoice-incoming/send -- it currently
# returns 405 "You do not have permission to use this resource" -- and confirms
# whether that call creates a draft or immediately transmits an EDI 810 to Target.
# With it off, /po-invoice still runs every check and creates the Odoo draft.
SPRING_INVOICE_ENABLED=

# Google Sheets price list (OAuth "installed app" client, not a service account key)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
GOOGLE_TOKEN_PATH=./google-token.json
# Worksheet tab name and column headers for the price list
PRICE_SHEET_WORKSHEET=Sheet1
PRICE_SHEET_SKU_COLUMN=sku
PRICE_SHEET_PRICE_COLUMN=expected_unit_price

# Slack
SLACK_WEBHOOK_URL=
# Only needed to run slack_listener.py (the /po-review slash command, Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Camelot 3PL (WMS) -- only needed for shipment-quantity checks, not for pricing checks.
# CAMELOT_SHIPMENT_PROFILE must be an interface profile bound to the Shipment Export
# XMLPort (e.g. SAR_SHP_E) -- the inventory-only profile used elsewhere (SAR_ITEM_E)
# will not work for shipment lookups.
CAMELOT_SOAP_URL=
CAMELOT_USERNAME=
CAMELOT_PASSWORD=
CAMELOT_CLIENT=
CAMELOT_TRADING_PARTNER=
CAMELOT_SHIPMENT_PROFILE=

# Odoo -- only needed for --push-odoo-invoice. ODOO_API_KEY must be a dedicated API
# key (avatar -> My Profile -> Account Security -> New API Key), not your password --
# Odoo Online blocks password auth on the external API.
ODOO_DB_URL=
ODOO_DB_NAME=
ODOO_USER=
ODOO_API_KEY=
# Company/journal/partner IDs, confirmed via a real existing Target invoice (see README)
ODOO_COMPANY_ID=
ODOO_JOURNAL_ID=
ODOO_TARGET_PARTNER_ID=
